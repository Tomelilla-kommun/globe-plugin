    // No Cesium Ion token is required for the examples below.
    // Ion tokens are only needed for Cesium-hosted assets such as OSM Buildings and Cesium World Terrain.
    
    "layers": [
      
      // 3D-tile buildings with roof color sampling
      {
        "name": "Buildings",
        "title": "Buildings",
        "type": "THREEDTILE",
        "abstract": "Buidling tiles",
        "url": "data/buildings/tileset.json",
        "group": "threed",
        "queryable": true,
        "maximumScreenSpaceError": 16,
        "maximumMemoryUsage": 2048,
        "showOutline": true,
        "outlineColor": "BLACK",
        "roofColor": "sample",
        "roofNormalThreshold": 0.2,
        "roofColorLayer": "webservices:Ortofoto_0.16",
        "roofColorLodDistance": 6000,
        "roofColorImageSize": 3072,
        "roofColorFetchRadius": 1200,
        "visible": true,
        "style": {
            "color": "color('#FFFFFF', 1)"
        }
      },

      {
        "name": "Trees",
        "title": "Trees",
        "type": "THREEDTILE",
        "abstract": "Tree tiles",
        "url": "data/trees/tileset.json",
        "group": "threed",
        "queryable": true,
        "maximumScreenSpaceError": 16,
        "maximumMemoryUsage": 2048,
        "showOutline": true,
        "outlineColor": "BLACK",
        "showShadows": false,
        "visible": true,
        "style": "none"
      },

      // GLB/GLTF model with clipping of existing building layer
      {
        "name": "custom_model",
        "title": "Custom 3D model",
        "type": "THREEDTILE",
        "group": "threed",
        "dataType": "model",
        "url": "data/GLB_models/",
        "mask": {
          "Buildings": {
            "buffer": 2,
            "polygon": "data/mask/mask_wgs84.geojson"
          }
        },
        "visible": true,
        "models": [
          {
            "fileName": "custom_model_1.glb",
            "lat": 55.72612394884369,
            "lng": 14.096412337936734,
            "height": 0.0,
            "heightReference": "NONE",
            "rotHeading": 0,
            "animation": false
          }
        ]
      },

      // GLB/GLTF wind turbine models with WFS
